# Credenciales para subir diagramas a Camunda 8 (modelador web de Camunda Hub).
# Copia este archivo como .env (no se sube a git) y completa los valores.
#
# Dónde se obtienen (Camunda SaaS):
#   Camunda Hub > Organization > Manage organization > Administration API >
#   Create new credentials > marca "Hub API" (o "Web Modeler API") con permisos
#   de lectura y escritura. El secreto se muestra una sola vez.

CAMUNDA_CONSOLE_CLIENT_ID=
CAMUNDA_CONSOLE_CLIENT_SECRET=

# Proyecto de Camunda donde se guardan los diagramas.
# Para ver las claves disponibles: npm run camunda -- proyectos
CAMUNDA_PROJECT_KEY=

# Opcional: carpeta dentro del proyecto.
# CAMUNDA_FOLDER_KEY=

# Valores por defecto para Camunda SaaS (cámbialos solo si usas Self-Managed).
# CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
# CAMUNDA_CONSOLE_OAUTH_AUDIENCE=api.cloud.camunda.io
# CAMUNDA_HUB_API_URL=https://hub.cloud.camunda.io/api/v2
# CAMUNDA_VERSION_PLATAFORMA=8.10.0
